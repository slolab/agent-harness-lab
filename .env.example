# Copy to .env. Keep .env untracked. Secrets only.
# Set the one key that matches your provider in config.yaml, except for
# `claude` and `claude-science` with provider: anthropic use account login
# and deliberately ignore ANTHROPIC_API_KEY. Claude/OpenRouter requires its key.
#
#   provider: anthropic -> ANTHROPIC_API_KEY
#   provider: openrouter -> OPENROUTER_API_KEY
#   provider: openai    -> OPENAI_API_KEY
#   provider: gemini    -> GEMINI_API_KEY
#   provider: vertex    -> GOOGLE_API_KEY

GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# OPENROUTER_API_KEY=
